{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stutter Tracker",
  "version": "0.1.0",
  "identifier": "com.moenarch.stutter-tracker",
  "build": {
    "beforeDevCommand": "bun --cwd ../web dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "bun --cwd ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stutter Tracker",
        "width": 1200,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
