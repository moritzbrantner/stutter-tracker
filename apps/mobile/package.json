  },
  "dependencies": {
    "@stutter-tracker/compute-client": "workspace:*",
    "@stutter-tracker/shared": "workspace:*",
    "expo": "^55.0.0",
    "react": "^19.2.0",
    "react-native": "^0.83.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "~5.8.3"
  }
}
