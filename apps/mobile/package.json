{
  "name": "@stutter-tracker/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" App.tsx",
