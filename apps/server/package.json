{
  "name": "@stutter-tracker/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@stutter-tracker/shared": "workspace:*",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "~5.8.3"
  }
}
